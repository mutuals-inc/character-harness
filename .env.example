# Copy to .env and fill in the keys your character uses.
XAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: the command that opens the player app, so `npm start` opens it too.
# Run by the shell from this folder, like the path to the player binary; it
# must keep running while the player is open (on macOS, the binary inside the
# .app, not `open -a`).
# HARNESS_PLAYER=path/to/player
# or, with your own build: HARNESS_PLAYER="cd player && hz/hzbuild macos run"
# on Windows: HARNESS_PLAYER="cd player && hz\hzbuild.exe windows run"
