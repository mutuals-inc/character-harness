{
  "name": "mutuals-harness-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo:prepare": "node scripts/prepare-demo.ts",
    "dev": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts --production",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "desktop": "node desktop/prepare.mjs && electron desktop/main.cjs",
    "desktop:prepare": "node desktop/prepare.mjs",
    "web-player": "node scripts/web-player.ts"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.4",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "marked": "^18.1.2",
    "three": "^0.180.0",
    "vite": "^7.1.7",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "electron": "^45.1.0",
    "typescript": "^5.9.3"
  }
}
